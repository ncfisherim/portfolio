---
import Layout from '../layouts/Layout.astro';
import ReactionTask from '../components/ReactionTask.astro';
import Index from '../components/Index.astro';
import { profile, lede, entries, methods } from '../data/site';
---

<Layout>
	<div class="mx-auto max-w-6xl px-4 sm:px-8 lg:px-12">
		<header class="flex items-baseline justify-between py-5 text-sm">
			<h1 class="font-medium">
				<a href="/" class="group inline-flex items-baseline gap-2">
					<span class="font-mono text-kite transition-transform duration-300 group-hover:rotate-90" aria-hidden="true">+</span>
					{profile.name}
				</a>
			</h1>
			<nav aria-label="Primary" class="flex gap-5 text-muted">
				<a class="ul" href="#index">Index</a>
				<a class="ul" href="#contact">Contact</a>
			</nav>
		</header>

		<main id="main">
			<!-- Intro + the experiment -->
			<section class="grid items-end gap-10 pt-8 pb-16 sm:pt-14 lg:grid-cols-[1fr_minmax(0,24rem)] lg:gap-16 lg:pt-24 lg:pb-28">
				<div>
					<p class="max-w-[24ch] font-display text-[clamp(1.75rem,3.6vw,2.85rem)] leading-[1.08] font-[420] tracking-[-0.022em] text-pretty sm:max-w-[30ch]">
						{
							lede.map((s) =>
								s.to ? (
									<a class="ul" href={`#entry-${s.to}`} data-open={s.to}>{s.text}</a>
								) : (
									s.text
								),
							)
						}
					</p>
					<p class="mt-6 max-w-md text-[0.9375rem] text-muted">{profile.currently}</p>
				</div>
				<ReactionTask />
			</section>

			<Index entries={entries} />

			<section aria-labelledby="methods-h" class="grid gap-4 py-16 sm:grid-cols-[6.5rem_1fr] sm:gap-6 lg:py-24">
				<h2 id="methods-h" class="text-sm font-medium">Methods</h2>
				<p class="max-w-3xl font-display text-xl leading-snug sm:text-2xl">{methods}</p>
			</section>

			<section id="contact" aria-labelledby="contact-h" class="scroll-mt-6 border-t border-ink pt-6 pb-20 lg:pb-28">
				<h2 id="contact-h" class="text-sm font-medium">Contact</h2>
				<p class="mt-10 text-muted sm:mt-14">The easiest way to reach me:</p>
				<div class="mt-2 flex flex-wrap items-baseline gap-x-6 gap-y-3">
					<a
						class="ul font-display text-[clamp(1.45rem,6vw,4rem)] leading-tight tracking-[-0.02em] break-all sm:break-normal"
						href={`mailto:${profile.email}`}>{profile.email}</a
					>
					<button
						type="button"
						data-copy={profile.email}
						class="font-mono text-xs text-muted transition-colors hover:text-ink"
					>
						<span data-copy-label>Copy</span>
					</button>
				</div>
				<ul class="mt-10 flex gap-6 text-sm">
					{
						profile.links.map((l) => (
							<li>
								<a class="ul" href={l.href} target="_blank" rel="noopener">
									{l.label}
									<span class="sr-only"> (opens in new tab)</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>

		<footer class="flex flex-wrap justify-between gap-4 border-t border-line py-6 text-xs text-muted">
			<span>© {new Date().getFullYear()} {profile.name}</span>
			<span class="font-mono">
				n = 1 · built with Astro &amp; Claude Code ·
				<a class="ul" href="https://github.com/ncfisherim/portfolio" target="_blank" rel="noopener">source</a>
			</span>
		</footer>
	</div>
</Layout>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
		const label = btn.querySelector('[data-copy-label]')!;
		btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(btn.dataset.copy!);
				label.textContent = 'Copied ✓';
			} catch {
				label.textContent = 'Press Ctrl+C';
			}
			setTimeout(() => (label.textContent = 'Copy'), 1800);
		});
	});
</script>
