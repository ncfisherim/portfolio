---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Index from '../components/Index.astro';
import Skills from '../components/Skills.astro';
import { profile, entries, skills } from '../data/site';
---

<Layout>
	<header class="fixed inset-x-0 top-0 z-40 bg-paper/85 backdrop-blur-md">
		<div class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 text-sm sm:px-8 lg:px-12">
			<!-- The hero name shrinks into this slot on scroll (see Hero.astro) -->
			<a href="/" class="font-display text-[1.0625rem] font-[520] tracking-[-0.01em]" data-header-name>{profile.name}</a>
			<nav aria-label="Primary" class="flex gap-3.5 text-muted min-[400px]:gap-5">
				<a class="ul" href="#research">Research</a>
				<a class="ul" href="#work">Work</a>
				<a class="ul" href="#contact">Contact</a>
				<a class="ul hidden sm:inline" href={profile.resume} target="_blank" rel="noopener">Résumé<span class="sr-only"> (PDF, opens in new tab)</span></a>
			</nav>
		</div>
	</header>

	<div class="mx-auto max-w-6xl px-4 pt-14 sm:px-8 lg:px-12">
		<main id="main">
			<Hero name={profile.name} />

			<Index id="research" title="Research Experience" entries={entries.filter((e) => e.section === 'research')} />
			<Index id="work" title="Work Experience" class="mt-16 lg:mt-24" entries={entries.filter((e) => e.section === 'work')} />

			<Skills groups={skills} />

			<section id="contact" aria-labelledby="contact-h" class="scroll-mt-20 border-t-2 border-kite pt-6 pb-20 lg:pb-28">
				<h2 id="contact-h" class="font-display text-2xl font-medium tracking-[-0.015em] text-kite-ink sm:text-3xl">Contact</h2>
				<div class="mt-10 flex flex-wrap items-center gap-x-5 gap-y-3 sm:mt-14">
					<a
						class="ul font-display text-xl leading-tight sm:text-2xl tracking-[-0.02em] break-all sm:break-normal"
						href={`mailto:${profile.email}`}>{profile.email}</a
					>
					<button
						type="button"
						data-copy={profile.email}
						class="rounded-md border border-ink/25 px-3.5 py-1.5 text-sm font-medium text-ink transition-colors hover:border-kite hover:text-kite-ink focus-visible:border-kite"
					>
						<span data-copy-label>Copy</span>
					</button>
				</div>
				<ul class="mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm">
					{
						profile.links.map((l) => (
							<li>
								<a class="ul" href={l.href} target="_blank" rel="noopener">
									{l.label}
									<span class="sr-only"> (opens in new tab)</span>
								</a>
							</li>
						))
					}
					<li>
						<a class="ul" href={profile.resume} target="_blank" rel="noopener">
							Résumé <span class="font-mono text-xs text-muted">PDF</span>
							<span class="sr-only"> (opens in new tab)</span>
						</a>
					</li>
				</ul>
			</section>
		</main>

		<footer class="flex flex-wrap justify-between gap-4 border-t border-line py-6 text-xs text-muted">
			<span>© {new Date().getFullYear()} {profile.name}</span>
			<span class="font-mono">
				Built with Astro &amp; Claude Code ·
				<a class="ul" href="https://github.com/ncfisherim/portfolio" target="_blank" rel="noopener">source</a>
			</span>
		</footer>
	</div>
</Layout>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
		const label = btn.querySelector('[data-copy-label]')!;
		btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(btn.dataset.copy!);
				label.textContent = 'Copied ✓';
			} catch {
				label.textContent = 'Press Ctrl+C';
			}
			setTimeout(() => (label.textContent = 'Copy'), 1800);
		});
	});
</script>
