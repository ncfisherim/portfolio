---
// The hero: just the name, centered, with wind moving through it.
// Three motions (all disabled under prefers-reduced-motion):
//   1. Wind — gusts sweep across the letters as waves of font weight (Funnel Display's
//      300–800 wght axis). The cursor/finger acts as wind too, and fast scrolling kicks up a gust.
//   2. Particles — faint streaks drift left→right behind the name. Gusts are shared: where a gust
//      front is passing through the letters, the streaks at that x speed up and stretch.
//   3. Morph — as you scroll, the name shrinks into the header slot [data-header-name] and hands off.
interface Props {
	name: string;
	role?: string;
}
const { name, role } = Astro.props;
const words = name.split(' ');
---

<section class="hero relative flex min-h-[calc(100svh-3.5rem)] items-center justify-center" aria-label="Introduction" data-hero>
	<canvas class="wind" data-wind aria-hidden="true"></canvas>
	<!-- Wrapper keeps the name itself centered; the role line hangs below it (absolute) -->
	<div class="relative">
	<h1 class="name relative text-center font-display leading-[0.86] tracking-[-0.035em]" data-hero-name>
		<span class="sr-only">{name}</span>
		<span aria-hidden="true" class="inline-block origin-top-left will-change-transform" data-hero-inner>
			{
				words.map((w, wi) => (
					<span class="word">
						{[...w].map((ch) => (
							<span class="ch" data-ch>{ch}</span>
						))}
						{wi < words.length - 1 && <span class="sp"> </span>}
					</span>
				))
			}
		</span>
	</h1>
	{
		role && (
			<p class="role" data-hero-role>
				{role.split(' · ').map((part, i) => (
					<>
						{i > 0 && <span class="role-dot" aria-hidden="true"> · </span>}
						<span class="role-part">{part}</span>
					</>
				))}
			</p>
		)
	}
	</div>
	<!-- Scroll cue: a down arrow in a circle, floating gently up and down; fades out as soon as you scroll -->
	<a href="#research" class="cue" data-cue>
		<span class="cue-ring" aria-hidden="true">
			<svg viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
				<path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" />
			</svg>
		</span>
		<span class="sr-only">Skip to Research Experience</span>
	</a>
</section>

<style>
	.name {
		font-weight: 340;
		/* two lines on phones, one line from tablet up */
		font-size: clamp(3rem, 22.5vw, 8rem);
	}
	.word {
		display: block;
		white-space: nowrap;
	}
	.sp {
		display: none;
	}
	@media (min-width: 640px) {
		.name {
			font-size: min(10.4vw, 8.75rem);
		}
		.word {
			display: inline;
		}
		.sp {
			display: inline;
		}
	}
	.ch {
		font-weight: var(--w, 340);
	}
	/* Full-bleed particle layer: spans the viewport width and runs up under the header */
	.wind {
		position: absolute;
		top: -3.5rem;
		bottom: 0;
		left: calc(50% - 50vw);
		width: 100vw;
		height: calc(100% + 3.5rem);
		pointer-events: none;
	}
	/* The hero is clickable (bursts): no accidental text selection */
	.hero {
		-webkit-user-select: none;
		user-select: none;
		-webkit-tap-highlight-color: transparent;
	}
	/* Role line under the name: muted, centered; stacked on phones, one line with dots from 640px */
	.role {
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		margin-top: 1.75rem;
		width: max-content;
		max-width: calc(100vw - 2rem);
		text-align: center;
		font-size: 0.9375rem;
		line-height: 1.5;
		color: var(--color-muted);
	}
	.role-part {
		display: block;
	}
	.role-dot {
		display: none;
		color: var(--color-kite);
	}
	@media (min-width: 640px) {
		.role {
			margin-top: 2.25rem;
			font-size: 1.0625rem;
		}
		.role-part {
			display: inline;
		}
		.role-dot {
			display: inline;
		}
	}
	.cue {
		position: absolute;
		left: 50%;
		bottom: 1.25rem;
		transform: translateX(-50%);
		display: grid;
		place-items: center;
		padding: 0.25rem; /* tap target ≈ 56px */
		color: color-mix(in oklab, var(--color-ink) 72%, transparent);
	}
	.cue-ring {
		display: grid;
		place-items: center;
		width: 3rem;
		height: 3rem;
		border: 1.5px solid currentColor;
		border-radius: 50%;
		transition: color 0.2s, background-color 0.2s;
		animation: cue-bob 2.4s ease-in-out infinite;
	}
	.cue:hover,
	.cue:focus-visible {
		color: var(--color-kite);
	}
	.cue:hover .cue-ring {
		background: color-mix(in oklab, var(--color-kite) 10%, transparent);
	}
	@keyframes cue-bob {
		0%, 100% { transform: translateY(-3px); }
		50% { transform: translateY(4px); }
	}
	@media (prefers-reduced-motion: reduce) {
		.wind {
			display: none;
		}
		.cue-ring {
			animation: none;
		}
	}
</style>

<script>
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const h1 = document.querySelector<HTMLElement>('[data-hero-name]');
	const inner = document.querySelector<HTMLElement>('[data-hero-inner]');
	const slot = document.querySelector<HTMLElement>('[data-header-name]');
	const canvas = document.querySelector<HTMLCanvasElement>('[data-wind]');
	const chars = [...document.querySelectorAll<HTMLElement>('[data-ch]')];

	if (hero && h1 && inner && slot && canvas && chars.length) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
		const BASE = 340;
		const SLOT_W = 520; // header name weight (matches the [data-header-name] link)
		const MAX = 800;
		const n = chars.length;

		// ── Layout measurements ───────────────────────────────────────────────────
		let p = 0; // 0 = hero, 1 = docked in header
		let range = 1;
		let scale1 = 0.12;
		let slotLeft = 0;
		// name bounds in viewport coords at p = 0 (used to place gusts in the particle field)
		let nameLeft = 0,
			nameWidth = 1;

		const measure = () => {
			inner.style.transform = '';
			const r = inner.getBoundingClientRect();
			const s = slot.getBoundingClientRect();
			range = Math.max(1, r.top + window.scrollY - s.top); // scroll distance until it reaches the slot
			scale1 = parseFloat(getComputedStyle(slot).fontSize) / parseFloat(getComputedStyle(h1).fontSize);
			slotLeft = s.left;
			nameLeft = r.left;
			nameWidth = r.width;
			sizeCanvas();
			update();
		};

		// The name is centered and its width changes with weight, so its untransformed left
		// edge moves. We READ it at the start of a frame / scroll event (layout is clean then)
		// and only WRITE afterwards — reading after writing would force a synchronous reflow.
		let curLeft = 0;
		const readLeft = () => {
			curLeft = h1.getBoundingClientRect().left + inner.offsetLeft; // h1 itself is untransformed
		};
		const applyTransform = () => {
			if (reduce.matches) return;
			const dx = slotLeft - curLeft;
			inner.style.transform = `translateX(${dx * p}px) scale(${1 + (scale1 - 1) * p})`;
		};

		const cue = document.querySelector<HTMLElement>('[data-cue]');
		const roleLine = document.querySelector<HTMLElement>('[data-hero-role]');
		const update = () => {
			const sy = window.scrollY; // read before writing
			p = Math.min(1, Math.max(0, sy / range));
			readLeft();
			applyTransform();
			const hand = Math.min(1, Math.max(0, (p - 0.86) / 0.14)); // cross-fade into the header name
			h1.style.opacity = String(1 - hand);
			slot.style.opacity = String(hand);
			slot.style.pointerEvents = hand > 0.5 ? 'auto' : 'none';
			canvas.style.opacity = String(Math.max(0, 1 - p * 1.8));
			if (roleLine) roleLine.style.opacity = String(Math.max(0, 1 - p * 3)); // role line leaves early, before the name shrinks much
			if (cue) {
				const o = Math.max(0, 1 - sy / 120); // scroll cue fades as soon as you scroll
				cue.style.opacity = String(o);
				cue.style.visibility = o === 0 ? 'hidden' : 'visible';
			}
		};

		// ── Shared wind state ─────────────────────────────────────────────────────
		type Gust = { t0: number; dur: number; amp: number; width: number };
		const gusts: Gust[] = [];
		const gust = (now: number, amp = 260 + Math.random() * 160) =>
			gusts.push({ t0: now, dur: 1300 + Math.random() * 700, amp, width: 1.6 + Math.random() * 1.4 });
		const front = (g: Gust, now: number) => -3 + ((now - g.t0) / g.dur) * (n + 6); // in letter units
		let nextGust = performance.now() + 700; // first gust shortly after load

		let px = -1e4,
			py = -1e4,
			pointerT = 0,
			touching = false,
			lastWasTouch = false;
		const onPointer = (e: PointerEvent) => {
			if (e.pointerType === 'touch') return; // touches are handled below
			px = e.clientX;
			py = e.clientY;
			pointerT = performance.now();
			lastWasTouch = false;
		};
		window.addEventListener('pointermove', onPointer, { passive: true });
		window.addEventListener('pointerdown', onPointer, { passive: true });
		// Touch: pointer events are cancelled once the browser starts scrolling, but touch
		// events keep arriving — so a finger keeps acting as wind while you scroll.
		const onTouch = (e: TouchEvent) => {
			const t = e.touches[0];
			if (!t) return;
			px = t.clientX;
			py = t.clientY;
			pointerT = performance.now();
			touching = true;
			lastWasTouch = true;
		};
		window.addEventListener('touchstart', onTouch, { passive: true });
		window.addEventListener('touchmove', onTouch, { passive: true });
		const endTouch = () => {
			touching = false;
			pointerT = performance.now(); // let the effect fade out briefly after lifting
		};
		window.addEventListener('touchend', endTouch, { passive: true });
		window.addEventListener('touchcancel', endTouch, { passive: true });

		// Bursts: a mouse click, or a *tap* (finger barely moved, lifted quickly) — so starting a
		// scroll never fires one. Touch is detected directly because iOS doesn't send clicks on
		// non-interactive areas reliably. Links/buttons in the hero (the scroll cue) are excluded.
		const inHero = (t: EventTarget | null) =>
			t instanceof Element && !!t.closest('[data-hero]') && !t.closest('a, button');
		let tap = { x: 0, y: 0, t: 0, ok: false };
		let lastTapBurst = 0;
		window.addEventListener(
			'touchstart',
			(e) => {
				const t = e.touches[0];
				tap = { x: t.clientX, y: t.clientY, t: performance.now(), ok: e.touches.length === 1 && inHero(e.target) };
			},
			{ passive: true },
		);
		window.addEventListener(
			'touchend',
			(e) => {
				const t = e.changedTouches[0];
				if (!t || !tap.ok) return;
				if (performance.now() - tap.t < 350 && Math.hypot(t.clientX - tap.x, t.clientY - tap.y) < 12) {
					burst(t.clientX, t.clientY);
					lastTapBurst = performance.now();
				}
			},
			{ passive: true },
		);
		hero.addEventListener('click', (e) => {
			if (performance.now() - lastTapBurst < 800) return; // already handled as a tap
			if (!inHero(e.target)) return;
			burst(e.clientX, e.clientY);
		});

		// ── Letters ───────────────────────────────────────────────────────────────
		const w = new Float32Array(n).fill(BASE);
		let centers: { x: number; y: number }[] = [];
		const measureCenters = () => {
			centers = chars.map((c) => {
				const r = c.getBoundingClientRect();
				return { x: r.left + r.width / 2, y: r.top + r.height / 2 };
			});
		};

		// ── Particles ─────────────────────────────────────────────────────────────
		const ctx = canvas.getContext('2d')!;
		let W = 0,
			H = 0,
			cLeft = 0,
			cTop = 0;
		type P = { x: number; y: number; z: number; vx: number; vy: number; g: number; ph: number; hot: boolean };
		const parts: P[] = [];
		const spawn = (anywhere: boolean): P => ({
			x: anywhere ? Math.random() * W : -20 - Math.random() * 60,
			y: Math.random() * H,
			z: 0.35 + Math.random() * 0.65, // depth: nearer = faster, bigger, darker
			vx: 0,
			vy: 0,
			g: 0,
			ph: Math.random() * Math.PI * 2,
			hot: Math.random() < 0.07, // a few kite-orange ones
		});
		// ── Click / tap bursts ──────────────────────────────────────────────────
		// A ring of streaks flies out from the point, drags to a stop, drifts off on the breeze.
		// Nearby ambient streaks get shoved outward and nearby letters pulse heavier.
		type Spark = { x: number; y: number; vx: number; vy: number; t0: number; life: number; hot: boolean; z: number };
		const sparks: Spark[] = [];
		const pulses: { x: number; y: number; t0: number }[] = []; // viewport coords
		const burst = (clientX: number, clientY: number) => {
			if (reduce.matches) return;
			const now = performance.now();
			const x = clientX - cLeft,
				y = clientY - (cTop - window.scrollY);
			const count = W < 640 ? 22 : 30;
			for (let i = 0; i < count; i++) {
				const a = (i / count) * Math.PI * 2 + Math.random() * 0.35;
				const sp = 2.5 + Math.random() * 5.5;
				sparks.push({
					x, y,
					vx: Math.cos(a) * sp,
					vy: Math.sin(a) * sp,
					t0: now,
					life: 700 + Math.random() * 650,
					hot: Math.random() < 0.3,
					z: 0.5 + Math.random() * 0.5,
				});
			}
			if (sparks.length > 160) sparks.splice(0, sparks.length - 160);
			// shockwave through the ambient field
			for (const q of parts) {
				const dx = q.x - x,
					dy = q.y - y,
					d = Math.hypot(dx, dy) || 1;
				if (d < 180) {
					const f = (1 - d / 180) * 5;
					q.vx += (dx / d) * f;
					q.vy += (dy / d) * f * 0.8;
				}
			}
			pulses.push({ x: clientX, y: clientY, t0: now });
			if (pulses.length > 4) pulses.shift();
			measureCenters(); // safe here: an input event, before this frame's writes
			lastMeasure = now;
			start();
		};

		let ink = '#121211',
			kite = '#ff4a1c';
		const readColors = () => {
			const cs = getComputedStyle(document.documentElement);
			ink = cs.getPropertyValue('--color-ink').trim() || ink;
			kite = cs.getPropertyValue('--color-kite').trim() || kite;
		};
		function sizeCanvas() {
			const r = canvas!.getBoundingClientRect();
			const dpr = Math.min(2, window.devicePixelRatio || 1);
			W = r.width;
			H = r.height;
			cLeft = r.left;
			cTop = r.top + window.scrollY;
			canvas!.width = Math.round(W * dpr);
			canvas!.height = Math.round(H * dpr);
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			const target = Math.round(Math.min(150, Math.max(60, (W * H) / 9000)));
			while (parts.length < target) parts.push(spawn(true));
			parts.length = target;
		}

		// ── Frame loop ────────────────────────────────────────────────────────────
		let raf = 0,
			running = false,
			lastMeasure = 0,
			lastT = performance.now(),
			lastY = window.scrollY;

		const frame = (now: number) => {
			raf = 0;
			if (!running) return;
			const dt = Math.min(48, now - lastT) / 16.67; // 1 = one 60fps frame
			lastT = now;

			// fast scroll → a gust
			const sy = window.scrollY; // read once, before any writes this frame
			const sv = Math.abs(sy - lastY) / (dt * 16.67);
			if (sv > 1.2 && gusts.length < 2) gust(now, 200 + Math.min(260, sv * 60));
			lastY = sy;

			if (now > nextGust) {
				gust(now);
				nextGust = now + 5200 + Math.random() * 4000;
			}
			for (let g = gusts.length - 1; g >= 0; g--) if (now - gusts[g].t0 > gusts[g].dur) gusts.splice(g, 1);

			// ── READ phase: all layout reads happen here, before any style writes ──
			// Mouse: live for 2.5s after it moves. Finger: live while down + 0.4s after lifting.
			// Either way it keeps working while the name is still big (during the scroll morph).
			const pointerLive =
				(touching || now - pointerT < (lastWasTouch ? 400 : 2500)) && p < 0.7;
			// Letters move while scrolling/touching, so re-measure every frame then; otherwise throttle.
			for (let k = pulses.length - 1; k >= 0; k--) if (now - pulses[k].t0 > 1200) pulses.splice(k, 1);
			if ((pointerLive || pulses.length) && (touching || p > 0 || now - lastMeasure > 250)) {
				measureCenters();
				lastMeasure = now;
			}
			if (p > 0) readLeft();

			const windR = Math.min(160, window.innerWidth * 0.32); // smaller "hand" on phones

			// ── WRITE phase ──
			// letters
			const base = BASE + (SLOT_W - BASE) * p; // settle toward header weight as it docks
			for (let i = 0; i < n; i++) {
				let target = base + Math.sin(now / 1400 + i * 0.7) * 10; // faint breathing
				for (const g of gusts) {
					const d = (i - front(g, now)) / g.width;
					target += g.amp * Math.exp(-d * d);
				}
				if (pointerLive && centers[i]) {
					const ddx = centers[i].x - px,
						ddy = centers[i].y - py;
					target += 300 * Math.exp(-(ddx * ddx + ddy * ddy) / (windR * windR));
				}
				for (const pu of pulses) {
					if (!centers[i]) break;
					const ddx = centers[i].x - pu.x,
						ddy = centers[i].y - pu.y,
						env = Math.exp(-(now - pu.t0) / 320); // quick hit, quick decay
					target += 340 * env * Math.exp(-(ddx * ddx + ddy * ddy) / (windR * windR * 1.4));
				}
				target = Math.min(MAX, target);
				w[i] += (target - w[i]) * 0.14;
				chars[i].style.setProperty('--w', w[i].toFixed(0));
			}
			if (p > 0) applyTransform(); // re-pin the left edge (measured at frame start)

			// particles (skip drawing once faded out)
			if (p < 0.56) {
				ctx.clearRect(0, 0, W, H);
				const letterPx = nameWidth / n;
				const narrow = Math.min(1, 0.5 + W / 1600); // gusts push a bit less on phones
				const gx = gusts.map((g) => ({
					x: nameLeft - cLeft + front(g, now) * letterPx, // gust front in canvas px
					s: g.width * letterPx * 1.6,
					a: g.amp / 400,
					// The front's own speed (px/frame). Streaks are never pushed faster than 60% of
					// it — otherwise on narrow screens they "surf" the front and bunch into one clump.
					cap: 0.6 * (((n + 6) * letterPx) / (g.dur / 16.67)),
				}));
				const pcx = px - cLeft,
					pcy = py - (cTop - sy);
				for (const q of parts) {
					// Gusts don't change a streak's drift speed (that redistributes them into clumps on
					// narrow screens). Instead `q.g` — local gust strength — stretches the streak and
					// surges it slightly forward, then eases back. Positions stay evenly spread.
					let boost = 0;
					for (const g of gx) {
						const d = (q.x - g.x) / g.s;
						boost += Math.min(g.cap, g.a * 9 * q.z * narrow) * Math.exp(-d * d);
					}
					q.g += (boost - q.g) * 0.12 * dt;
					const target = 0.45 + q.z * 0.9; // steady breeze
					q.vx += (target - q.vx) * 0.07 * dt;
					if (pointerLive) {
						const ddx = q.x - pcx,
							ddy = q.y - pcy,
							d2 = ddx * ddx + ddy * ddy;
						if (d2 < 140 * 140) {
							const f = (1 - Math.sqrt(d2) / 140) * 0.6;
							q.vy += (ddy >= 0 ? 1 : -1) * f;
							q.vx += f * 0.6;
						}
					}
					q.vy *= 0.9;
					q.x += q.vx * dt;
					q.y += (Math.sin(now / 1100 + q.ph) * 0.18 * q.z + q.vy) * dt;
					// Off the right edge: wrap straight back in on the left (keeps the field evenly dense).
					// Off top/bottom: a fresh streak from the left.
					if (q.x > W + 40) {
						q.x -= W + 80;
						q.y = Math.random() * H;
						q.vy = 0;
					} else if (q.y < -20 || q.y > H + 20) Object.assign(q, spawn(false));

					const len = 3 + (q.vx + q.g) * 5; // faster or gustier → longer streak
					const xd = q.x + q.g * 4; // small forward surge inside a gust
					ctx.globalAlpha = (q.hot ? 0.55 : 0.12 + 0.22 * q.z) * Math.min(1, (q.x + 30) / 120);
					ctx.strokeStyle = q.hot ? kite : ink;
					ctx.lineWidth = 0.6 + q.z * 0.9;
					ctx.beginPath();
					ctx.moveTo(xd - len, q.y);
					ctx.lineTo(xd, q.y);
					ctx.stroke();
				}

				// burst sparks: drag to a stop, then drift right on the breeze, fading out
				const drag = Math.pow(0.93, dt);
				for (let k = sparks.length - 1; k >= 0; k--) {
					const s = sparks[k];
					const age = (now - s.t0) / s.life;
					if (age >= 1) {
						sparks.splice(k, 1);
						continue;
					}
					s.vx = s.vx * drag + 0.05 * dt;
					s.vy = s.vy * drag;
					s.x += s.vx * dt;
					s.y += s.vy * dt;
					const sp = Math.hypot(s.vx, s.vy) || 1;
					const len = 2 + sp * 3.2; // streak points back along its motion
					ctx.globalAlpha = (1 - age) * (s.hot ? 0.9 : 0.6);
					ctx.strokeStyle = s.hot ? kite : ink;
					ctx.lineWidth = 0.8 + s.z * 1.1;
					ctx.beginPath();
					ctx.moveTo(s.x - (s.vx / sp) * len, s.y - (s.vy / sp) * len);
					ctx.lineTo(s.x, s.y);
					ctx.stroke();
				}
				ctx.globalAlpha = 1;
			}

			raf = requestAnimationFrame(frame);
		};

		const start = () => {
			if (running || reduce.matches || document.hidden) return;
			running = true;
			lastT = performance.now();
			measureCenters();
			raf = requestAnimationFrame(frame);
		};
		const stop = () => {
			running = false;
			if (raf) cancelAnimationFrame(raf);
			raf = 0;
		};

		// Only animate while the hero is on screen
		new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(hero);
		document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
		reduce.addEventListener('change', () => {
			if (reduce.matches) {
				stop();
				chars.forEach((c) => c.style.removeProperty('--w'));
				inner.style.transform = '';
			} else start();
			update();
		});
		window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', readColors);

		window.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', measure);
		readColors();
		document.fonts.ready.then(measure);
		measure();
		start();
	}
</script>
