---
// A tiny jsPsych-style simple reaction-time task.
// 5 trials · random 0.9–2.5 s foreperiod · false starts are caught and the trial repeats.
const TRIALS = 5;
---

<figure class="rt">
	<div
		class="stage"
		data-rt
		data-state="idle"
		data-trials={TRIALS}
		role="button"
		tabindex="0"
		aria-describedby="rt-desc"
	>
		<span class="fix" aria-hidden="true"></span>
		<span class="stim" aria-hidden="true"></span>

		<div class="msg msg-idle">
			<span class="hint-touch">Tap to begin</span>
			<span class="hint-fine">Click or press space to begin</span>
		</div>
		<div class="msg msg-early" aria-hidden="true">
			<span class="big">Too soon</span>
			<span class="small">Wait for the square. Trial repeats.</span>
		</div>
		<div class="msg msg-feedback" aria-hidden="true">
			<span class="big"><span data-rt-last>—</span><span class="unit">ms</span></span>
		</div>
		<div class="msg msg-done">
			<span class="small">Your mean reaction time</span>
			<span class="big"><span data-rt-mean>—</span><span class="unit">ms</span></span>
			<div class="strip" aria-hidden="true">
				<span class="band" title="Typical online range"></span>
				<div class="dots" data-rt-dots></div>
				<span class="tick tick-l">150</span>
				<span class="tick tick-r">550 ms</span>
			</div>
			<span class="small">
				best trial <span data-rt-best>—</span> ms · <span class="hint-touch">tap</span><span class="hint-fine">click</span> to run again
			</span>
		</div>
	</div>

	<figcaption class="caption">
		<div class="meta">
			<span>Trial <span data-rt-n>0</span>/{TRIALS}</span>
			<span data-rt-record hidden>Your best mean: <span data-rt-record-val></span> ms</span>
		</div>
		<p id="rt-desc">
			A small experiment, the kind I build. When the <span class="kite">orange square</span> replaces the
			cross, respond as fast as you can. Online, most people land around 250–350&nbsp;ms. Nothing leaves your
			browser.
		</p>
	</figcaption>
	<p class="sr-only" aria-live="polite" data-rt-live></p>
</figure>

<style>
	.rt {
		margin: 0;
	}
	.stage {
		position: relative;
		aspect-ratio: 1 / 1;
		width: 100%;
		background: var(--color-stage);
		color: #111;
		display: grid;
		place-items: center;
		cursor: pointer;
		user-select: none;
		-webkit-user-select: none;
		touch-action: manipulation;
		-webkit-tap-highlight-color: transparent;
		overflow: hidden;
	}
	@media (max-width: 1023px) {
		.stage { aspect-ratio: 4 / 3; }
	}
	/* Focus ring only for keyboard users, not after a click/tap */
	.stage[data-pointer]:focus-visible {
		outline: none;
	}

	/* Fixation cross */
	.fix {
		position: absolute;
		width: 28px;
		height: 28px;
	}
	.fix::before,
	.fix::after {
		content: "";
		position: absolute;
		background: #111;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%);
	}
	.fix::before { width: 100%; height: 3px; }
	.fix::after { width: 3px; height: 100%; }

	/* Stimulus */
	.stim {
		position: absolute;
		width: 22%;
		aspect-ratio: 1;
		background: var(--color-kite);
		visibility: hidden;
	}

	.msg {
		position: absolute;
		inset: 0;
		display: none;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 1.25rem;
		text-align: center;
	}
	.msg-idle {
		justify-content: flex-end;
		padding-bottom: 1.5rem;
		font-size: 0.875rem;
		font-weight: 500;
	}
	.big {
		font-family: var(--font-mono);
		font-size: clamp(2.5rem, 7vw, 3.75rem);
		line-height: 1;
		letter-spacing: -0.03em;
		font-variant-numeric: tabular-nums;
	}
	.msg-early .big {
		font-family: var(--font-display);
		letter-spacing: -0.02em;
	}
	.unit {
		font-size: 0.4em;
		margin-left: 0.2em;
		letter-spacing: 0;
	}
	.small {
		font-size: 0.8125rem;
	}

	/* State machine → visibility */
	[data-state="idle"] .fix,
	[data-state="wait"] .fix { visibility: visible; }
	[data-state="go"] .fix,
	[data-state="early"] .fix,
	[data-state="feedback"] .fix,
	[data-state="done"] .fix { visibility: hidden; }
	[data-state="go"] .stim { visibility: visible; }
	[data-state="idle"] .msg-idle,
	[data-state="early"] .msg-early,
	[data-state="feedback"] .msg-feedback,
	[data-state="done"] .msg-done { display: flex; }

	/* Result strip: 150–550 ms axis, shaded 250–350 typical band */
	.strip {
		position: relative;
		width: min(100%, 300px);
		height: 34px;
		margin: 0.4rem 0 1.6rem;
		border-bottom: 1px solid #111;
	}
	.band {
		position: absolute;
		left: 25%;
		width: 25%;
		top: 4px;
		bottom: 0;
		background: rgb(0 0 0 / 0.12);
	}
	.dots :global(i) {
		position: absolute;
		bottom: 6px;
		width: 9px;
		height: 9px;
		margin-left: -4.5px;
		background: #111;
		border-radius: 50%;
	}
	.dots :global(i.mean) {
		width: 3px;
		height: 26px;
		margin-left: -1.5px;
		bottom: 0;
		border-radius: 0;
		background: var(--color-kite);
	}
	.tick {
		position: absolute;
		top: 100%;
		margin-top: 4px;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
	}
	.tick-l { left: 0; }
	.tick-r { right: 0; }

	.caption {
		margin-top: 0.9rem;
		font-size: 0.875rem;
		line-height: 1.55;
		color: var(--color-muted);
	}
	.meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-ink);
		margin-bottom: 0.4rem;
		font-variant-numeric: tabular-nums;
	}
	.kite {
		color: var(--color-kite-ink);
	}

	/* Show the right instruction for the input device */
	.hint-fine { display: none; }
	@media (hover: hover) and (pointer: fine) {
		.hint-fine { display: inline; }
		.hint-touch { display: none; }
	}
</style>

<script>
	type State = 'idle' | 'wait' | 'go' | 'early' | 'feedback' | 'done';

	const stage = document.querySelector<HTMLElement>('[data-rt]');
	if (stage) {
		const TRIALS = Number(stage.dataset.trials) || 5;
		const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
		const nEl = $('[data-rt-n]');
		const lastEl = $('[data-rt-last]');
		const meanEl = $('[data-rt-mean]');
		const bestEl = $('[data-rt-best]');
		const dotsEl = $('[data-rt-dots]');
		const liveEl = $('[data-rt-live]');
		const recordEl = $('[data-rt-record]');
		const recordVal = $('[data-rt-record-val]');

		const KEY = 'rt-best-mean';
		const readRecord = (): number | null => {
			try {
				const v = Number(localStorage.getItem(KEY));
				return v > 0 ? v : null;
			} catch {
				return null;
			}
		};
		const writeRecord = (v: number) => {
			try {
				localStorage.setItem(KEY, String(v));
			} catch {}
		};
		const showRecord = (v: number | null) => {
			if (v === null) return;
			recordVal.textContent = String(v);
			recordEl.hidden = false;
		};
		showRecord(readRecord());

		let state: State = 'idle';
		let rts: number[] = [];
		let onset = 0;
		let timer = 0;

		const set = (s: State) => {
			state = s;
			stage.dataset.state = s;
		};
		const announce = (msg: string) => (liveEl.textContent = msg);

		const nextTrial = () => {
			set('wait');
			nEl.textContent = String(rts.length + 1);
			const foreperiod = 900 + Math.random() * 1600;
			timer = window.setTimeout(() => {
				set('go');
				// Timestamp the frame the stimulus is painted in (same clock as event.timeStamp)
				requestAnimationFrame((t) => (onset = t));
			}, foreperiod);
		};

		const finish = () => {
			const mean = Math.round(rts.reduce((a, b) => a + b, 0) / rts.length);
			const best = Math.round(Math.min(...rts));
			meanEl.textContent = String(mean);
			bestEl.textContent = String(best);
			const pos = (ms: number) => Math.min(100, Math.max(0, ((ms - 150) / 400) * 100));
			dotsEl.innerHTML =
				rts.map((r) => `<i style="left:${pos(r)}%"></i>`).join('') +
				`<i class="mean" style="left:${pos(mean)}%"></i>`;
			const prev = readRecord();
			if (prev === null || mean < prev) {
				writeRecord(mean);
				showRecord(mean);
			}
			set('done');
			announce(`Done. Mean reaction time ${mean} milliseconds, best trial ${best}.`);
		};

		const start = () => {
			rts = [];
			announce('Starting. Five trials.');
			nextTrial();
		};

		const respond = (t: number) => {
			switch (state) {
				case 'idle':
				case 'done':
					start();
					break;
				case 'wait':
					clearTimeout(timer);
					set('early');
					announce('Too soon. Trial repeats.');
					timer = window.setTimeout(nextTrial, 1100);
					break;
				case 'go': {
					if (!onset) return; // stimulus not painted yet
					const rt = t - onset;
					onset = 0;
					rts.push(rt);
					lastEl.textContent = String(Math.round(rt));
					set('feedback');
					timer = window.setTimeout(rts.length >= TRIALS ? finish : nextTrial, 750);
					break;
				}
				// 'early' and 'feedback' ignore input
			}
		};

		stage.addEventListener('pointerdown', (e) => {
			if (e.button !== 0) return;
			e.preventDefault();
			stage.dataset.pointer = '';
			stage.focus({ preventScroll: true });
			respond(e.timeStamp);
		});
		stage.addEventListener('keydown', (e) => {
			delete stage.dataset.pointer; // keyboard in use: show the focus ring again
			if (e.key !== ' ' && e.key !== 'Enter') return;
			e.preventDefault(); // don't scroll the page on space
			if (!e.repeat) respond(e.timeStamp);
		});
		// Abandon a run if the tab is hidden mid-trial (timings would be meaningless)
		document.addEventListener('visibilitychange', () => {
			if (document.hidden && state !== 'idle' && state !== 'done') {
				clearTimeout(timer);
				nEl.textContent = '0';
				set('idle');
			}
		});
	}
</script>
