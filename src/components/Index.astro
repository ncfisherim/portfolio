---
import { Image } from 'astro:assets';
import type { Entry } from '../data/site';

interface Props {
	id: string;
	title: string;
	entries: Entry[];
	class?: string;
}
const { id, title, entries, class: className = '' } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-h`} class:list={['scroll-mt-20', className]}>
	<div class="flex items-baseline justify-between border-b-2 border-kite pb-3">
		<h2 id={`${id}-h`} class="font-display text-2xl font-medium tracking-[-0.015em] text-kite-ink sm:text-3xl">{title}</h2>
		<span class="shrink-0 font-mono text-xs text-muted">{entries.length} {entries.length === 1 ? 'entry' : 'entries'}<span class="hidden sm:inline"> · newest first</span></span>
	</div>


	<div>
		{
			entries.map((e) => (
				<details class="entry group scroll-mt-20 border-b border-line" id={`entry-${e.id}`}>
					<summary class="grid grid-cols-[4.25rem_1fr_1.5rem] items-baseline gap-x-4 py-4 transition-colors hover:bg-ink/[0.03] sm:grid-cols-[6.5rem_1fr_9rem_1.5rem] sm:gap-x-6 sm:py-5">
						<span class="font-mono text-xs tabular-nums text-muted">{e.years}</span>
						<span>
							<span class="block text-[1.0625rem] leading-snug font-medium sm:text-lg" data-title>{e.title}</span>
							{e.org && <span class="block text-sm text-muted">{e.org}</span>}
							<span class="mt-0.5 block text-xs text-muted sm:hidden">{e.kind}</span>
						</span>
						<span class="hidden text-sm text-muted sm:block">{e.kind}</span>
						<span class="cross justify-self-end font-mono text-xl leading-none" aria-hidden="true">+</span>
					</summary>

					<div class="grid gap-x-6 pb-8 sm:grid-cols-[6.5rem_1fr_9rem_1.5rem]">
						<div class="sm:col-start-2 sm:col-end-4 max-w-2xl">
							{e.link && (
								<a class="ul mb-3 inline-block text-sm font-medium text-kite-ink" href={e.link.href} target="_blank" rel="noopener">
									{e.link.label}
									<span aria-hidden="true"> ↗</span>
									<span class="sr-only"> (opens in new tab)</span>
								</a>
							)}
							<p class="font-display text-xl leading-snug sm:text-2xl">{e.summary}</p>

							{e.media && (
								<div class:list={['mt-6', e.media.length > 1 && 'media-row']}>
									{e.media.map((m) => (
										<figure class="media">
											<Image
												src={m.src}
												alt={m.alt}
												widths={[480, 800, 1200, 1600]}
												sizes="(min-width: 768px) 42rem, calc(100vw - 2rem)"
												loading="lazy"
												decoding="async"
												class="h-auto w-full bg-line"
											/>
											{m.caption && <figcaption class="mt-2 text-xs text-muted">{m.caption}</figcaption>}
										</figure>
									))}
								</div>
							)}

							{e.stats && (
								<dl class="mt-6 flex flex-wrap gap-x-8 gap-y-4">
									{e.stats.map((s) => (
										<div class="flex flex-col-reverse">
											<dt class="text-xs text-muted">{s.label}</dt>
											<dd class="font-mono text-2xl tabular-nums">{s.value}</dd>
										</div>
									))}
								</dl>
							)}

							{e.points && (
								<ul class="mt-6 space-y-2.5 text-[0.9375rem] leading-relaxed">
									{e.points.map((p) => (
										<li class="grid grid-cols-[1rem_1fr]">
											<span class="text-kite" aria-hidden="true">–</span>
											<span>{p}</span>
										</li>
									))}
								</ul>
							)}

							{e.tools && <p class="mt-6 font-mono text-xs text-muted">{e.tools.join(' / ')}</p>}
						</div>
					</div>
				</details>
			))
		}
	</div>
</section>

<script>
	// Links like <a data-open="research"> open that entry before the browser jumps to it.
	const open = (id: string | null | undefined) => {
		if (!id) return;
		const d = document.getElementById(`entry-${id}`) as HTMLDetailsElement | null;
		if (d) d.open = true;
	};
	document.querySelectorAll<HTMLAnchorElement>('a[data-open]').forEach((a) =>
		a.addEventListener('click', () => open(a.dataset.open)),
	);
	if (location.hash.startsWith('#entry-')) open(location.hash.slice(7));
</script>
