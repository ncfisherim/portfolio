---
import { Image } from 'astro:assets';
import { termLinks, type Entry } from '../data/site';

// Split text so terms in termLinks (site.ts) render as outbound links
const terms = Object.keys(termLinks);
const termRe = terms.length ? new RegExp(`\\b(${terms.join('|')})\\b`) : null;
const linkify = (text: string) => (termRe ? text.split(termRe) : [text]);

interface Props {
	id: string;
	title: string;
	entries: Entry[];
	class?: string;
	// compact: for the narrow right-hand column on wide screens (lg+). Rows stack as
	// "descriptor · years" over "title · +" instead of four columns. Below lg it's the normal row.
	compact?: boolean;
}
const { id, title, entries, class: className = '', compact = false } = Astro.props;
const rowCols = compact ? 'lg:grid-cols-[1fr_auto] lg:gap-y-1.5' : 'lg:grid-cols-[6.5rem_1fr_4.5rem_1.5rem]';
---

<section id={id} aria-labelledby={`${id}-h`} class:list={['scroll-mt-20', className]}>
	<div class="border-b-2 border-kite pb-3">
		<h2 id={`${id}-h`} class="font-display text-2xl font-medium tracking-[-0.015em] text-kite-ink sm:text-3xl">{title}</h2>
	</div>


	<div>
		{
			entries.map((e) => {
				// Entries with nothing to reveal are a plain row: no <details>, no +.
				const expandable = !!(e.points || e.media || e.stats || e.link || e.tools || e.citation);
				const Wrap = expandable ? 'details' : 'div';
				const Row = expandable ? 'summary' : 'div';
				return (
				<Wrap class="entry group scroll-mt-20 border-b border-line" id={`entry-${e.id}`} open={expandable ? (e.open ?? true) : undefined}>
					<Row class:list={['grid grid-cols-[5.5rem_1fr_1.5rem] items-baseline gap-x-4 py-5 sm:grid-cols-[6.5rem_1fr_9rem_1.5rem] sm:gap-x-6 sm:py-6', rowCols, expandable && 'transition-colors hover:bg-ink/[0.03]']}>
						<span class:list={['kind font-display text-[0.8125rem] font-medium text-ink sm:text-[0.9375rem]', compact && 'lg:col-start-1 lg:row-start-1']}>{e.kind}</span>
						<span class:list={[compact && 'lg:col-start-1 lg:row-start-2']}>
							<span class="block text-[1.0625rem] leading-snug font-medium sm:text-lg" data-title>{e.title}</span>
							{e.org && (
								<span class="block text-sm text-muted">
									{/* " · " in org = line break on phones, inline dot on wider screens */}
									{e.org.split(' · ').map((part, i) => (
										<>
											{i > 0 && <span class="hidden sm:inline"> · </span>}
											<span class="block sm:inline">{part}</span>
										</>
									))}
								</span>
							)}
							{e.sublist && (
								<span class="block text-sm text-muted">
									{e.sublist.map((item) => (
										<span class="block">{item}</span>
									))}
								</span>
							)}
							{!expandable && e.summary && <span class="mt-1.5 block text-sm text-muted">{e.summary}</span>}
							<span class="mt-0.5 block font-mono text-xs tabular-nums text-muted sm:hidden">{e.years}</span>
						</span>
						<span class:list={['hidden text-right font-mono text-xs tabular-nums text-muted sm:block', compact && 'lg:col-start-2 lg:row-start-1']}>{e.years}</span>
						{expandable && <span class:list={['cross justify-self-end font-mono text-xl leading-none', compact && 'lg:col-start-2 lg:row-start-2']} aria-hidden="true">+</span>}
					</Row>
					{expandable && (

					<div class:list={['grid gap-x-6 pb-8 sm:grid-cols-[6.5rem_1fr_9rem_1.5rem]', compact ? 'lg:grid-cols-1' : 'lg:grid-cols-[6.5rem_1fr_4.5rem_1.5rem]']}>
						<div class:list={['sm:col-start-2 sm:col-end-4 max-w-2xl', compact && 'lg:col-start-1 lg:col-end-2']}>
							{e.link && (
								<a class="ul mb-4 inline-block text-base font-medium text-kite-ink sm:text-lg" href={e.link.href} target="_blank" rel="noopener">
									{e.link.label}
									<span aria-hidden="true"> ↗</span>
									<span class="sr-only"> (opens in new tab)</span>
								</a>
							)}
							{e.summary && <p class="font-display text-base leading-snug sm:text-[1.0625rem]">{e.summary}</p>}

							{e.media && (
								<div class:list={['mt-6', e.media.length > 1 && 'media-row']}>
									{e.media.map((m) => (
										<figure class="media">
											<Image
												src={m.src}
												alt={m.alt}
												widths={[480, 800, 1200, 1600]}
												sizes="(min-width: 768px) 42rem, calc(100vw - 2rem)"
												loading="lazy"
												decoding="async"
												class="h-auto w-full bg-line"
											/>
											{m.caption && <figcaption class="mt-2 text-xs text-muted">{m.caption}</figcaption>}
										</figure>
									))}
								</div>
							)}

							{e.stats && (
								<dl class="mt-6 flex flex-wrap gap-x-8 gap-y-4">
									{e.stats.map((s) => (
										<div class="flex flex-col-reverse">
											<dt class="text-xs text-muted">{s.label}</dt>
											<dd class="font-mono text-2xl tabular-nums">{s.value}</dd>
										</div>
									))}
								</dl>
							)}

							{e.points && (
								<ul class="mt-6 space-y-2.5 text-[0.9375rem] leading-relaxed">
									{e.points.map((p) => (
										<li class="grid grid-cols-[1rem_1fr]">
											<span class="text-kite" aria-hidden="true">–</span>
											<span>
												{linkify(p).map((part) =>
													termLinks[part] ? (
														<a class="ul" href={termLinks[part]} target="_blank" rel="noopener">{part}</a>
													) : (
														part
													),
												)}
											</span>
										</li>
									))}
								</ul>
							)}

							{e.tools && (
							<p class="mt-6 font-mono text-xs text-muted">
								{e.tools.map((t, i) => (
									<>
										{i > 0 && ' / '}
										{termLinks[t] ? (
											<a class="ul hover:text-ink" href={termLinks[t]} target="_blank" rel="noopener">{t}</a>
										) : (
											t
										)}
									</>
								))}
							</p>
						)}
						{e.citation && (
							<p class="mt-6 max-w-xl text-xs leading-relaxed text-muted">
								{/* bold the first author ("Fisher, N.") */}
								<span class="font-medium text-ink">{e.citation.split(', ').slice(0, 2).join(', ')}</span>
								{', ' + e.citation.split(', ').slice(2).join(', ')}
							</p>
						)}
						</div>
					</div>
					)}
				</Wrap>
				);
			})
		}
	</div>
</section>

<script>
	// Links like <a data-open="research"> open that entry before the browser jumps to it.
	const open = (id: string | null | undefined) => {
		if (!id) return;
		const d = document.getElementById(`entry-${id}`) as HTMLDetailsElement | null;
		if (d) d.open = true;
	};
	document.querySelectorAll<HTMLAnchorElement>('a[data-open]').forEach((a) =>
		a.addEventListener('click', () => open(a.dataset.open)),
	);
	if (location.hash.startsWith('#entry-')) open(location.hash.slice(7));
</script>
