---
interface Props {
	index: string;
	label: string;
	id?: string;
}
const { index, label, id } = Astro.props;
---

<section id={id} class="grid gap-6 border-t border-line py-14 md:grid-cols-[11rem_1fr] md:gap-10">
	<h2 class="font-mono text-xs uppercase tracking-[0.2em] text-muted md:sticky md:top-10 md:self-start">
		<span class="text-accent">{index}</span> — {label}
	</h2>
	<div>
		<slot />
	</div>
</section>
