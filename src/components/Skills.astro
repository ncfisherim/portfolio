---
// Skills that point to their proof.
// - Hover/focus a skill: the entries where it was used light up (+ turns orange) and a
//   "Used in" line names them.
// - Click/tap: jumps to those entries, opens them, and flashes them.
// - When the section scrolls into view, one gust sweeps through the words (same wind as the hero).
import type { skills as SkillsData } from '../data/site';

interface Props {
	groups: typeof SkillsData;
}
const { groups } = Astro.props;
---

<section id="skills" aria-labelledby="skills-h" class="scroll-mt-20 py-16 lg:py-24" data-skills>
	<!-- Same heading treatment as Research/Work: 2px kite rule under the title -->
	<div class="border-b-2 border-kite pb-3">
		<h2 id="skills-h" class="font-display text-2xl font-medium tracking-[-0.015em] text-kite-ink sm:text-3xl">Skills</h2>
	</div>

	<!-- groups line up with the entry titles above (6.5rem column + 1.5rem gap) -->
	<div class="mt-8 sm:pl-32">
		<div class="grid grid-cols-2 gap-x-6 gap-y-9 lg:grid-cols-3 lg:gap-x-10">
			{
				groups.map((g) => (
					<div>
						<h3 class="mb-2.5 text-xs text-muted">{g.group}</h3>
						<ul class="space-y-1">
							{g.items.map((s) => (
								<li>
									{s.proof ? (
										<button
											type="button"
											class="skill linked"
											data-skill
											data-proof={s.proof.join(' ')}
											data-evidence={JSON.stringify(s.evidence ?? [s.name])}
											aria-describedby="skills-hint"
										>
											{s.name}
										</button>
									) : (
										<span class="skill" data-skill>
											{s.name}
										</span>
									)}
									{s.note && <span class="text-muted"> ({s.note})</span>}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<p class="mt-10 min-h-[1.5rem] text-sm text-muted" data-skills-used aria-live="polite">
			<span id="skills-hint" class="sr-only">Jumps to the entries where I used this skill.</span>
		</p>
	</div>
</section>

<style>
	.skill {
		display: inline;
		text-align: left;
		font-family: var(--font-display);
		font-size: 1.0625rem;
		line-height: 1.35;
		letter-spacing: -0.01em;
		font-weight: var(--w, 380);
		color: var(--color-ink);
	}
	@media (min-width: 640px) {
		.skill {
			font-size: 1.1875rem;
		}
	}
	/* Linked skills: a dotted underline says "this goes somewhere" */
	.linked {
		text-decoration: underline dotted;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		text-decoration-color: color-mix(in oklab, currentColor 40%, transparent);
		transition:
			font-weight 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
			color 0.2s,
			text-decoration-color 0.2s;
	}
	[data-gusting] .linked {
		transition: none; /* let the gust drive weight frame by frame */
	}
	.linked:hover,
	.linked:focus-visible,
	.linked[data-active] {
		font-weight: 620;
		color: var(--color-kite-ink);
		text-decoration-style: solid;
		text-decoration-color: currentColor;
	}
</style>

<script>
	const section = document.querySelector<HTMLElement>('[data-skills]');
	const used = document.querySelector<HTMLElement>('[data-skills-used]');
	if (section && used) {
		const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
		const hintHTML = used.innerHTML;
		const words = [...section.querySelectorAll<HTMLElement>('[data-skill]')];
		const linked = words.filter((w) => w.dataset.proof) as HTMLButtonElement[];

		const entry = (id: string) => document.getElementById(`entry-${id}`) as HTMLDetailsElement | null;
		const titleOf = (id: string) => entry(id)?.querySelector('[data-title]')?.textContent?.trim() ?? id;
		const proofOf = (b: HTMLElement) => (b.dataset.proof ?? '').split(' ').filter(Boolean);

		// ── Preview: highlight the proof entries and name them ───────────────────
		let active: HTMLElement | null = null;
		const clearPreview = () => {
			document.querySelectorAll('.entry[data-proof-hl]').forEach((e) => e.removeAttribute('data-proof-hl'));
			active?.removeAttribute('data-active');
			active = null;
			used.innerHTML = hintHTML;
		};
		const preview = (b: HTMLElement) => {
			if (active === b) return;
			clearPreview();
			active = b;
			b.setAttribute('data-active', '');
			const ids = proofOf(b);
			ids.forEach((id) => entry(id)?.setAttribute('data-proof-hl', ''));
			used.textContent = '';
			used.append(`${b.textContent?.trim()} → Used in `);
			ids.forEach((id, i) => {
				const a = document.createElement('a');
				a.href = `#entry-${id}`;
				a.className = 'ul text-ink';
				a.textContent = titleOf(id);
				a.addEventListener('click', (ev) => {
					ev.preventDefault();
					jump([id], evidenceOf(b));
				});
				if (i) used.append(i === ids.length - 1 ? ' and ' : ', ');
				used.append(a);
			});
		};

		// ── Evidence marks: highlight the exact phrases that prove the skill ──────
		const evidenceOf = (b: HTMLElement): string[] => {
			try {
				return JSON.parse(b.dataset.evidence ?? '[]');
			} catch {
				return [];
			}
		};
		const clearMarks = (root: ParentNode = document) => {
			root.querySelectorAll('mark[data-evidence-hit]').forEach((m) => {
				const parent = m.parentNode!;
				parent.replaceChild(document.createTextNode(m.textContent ?? ''), m);
				parent.normalize(); // merge the text back into one node
			});
		};
		const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
		const markIn = (d: HTMLDetailsElement, phrases: string[]) => {
			if (!phrases.length) return;
			// longest first so a long phrase wins over a word inside it
			const re = new RegExp(
				[...phrases].sort((a, b) => b.length - a.length).map(escapeRe).join('|'),
				'gi',
			);
			const walker = document.createTreeWalker(d, NodeFilter.SHOW_TEXT, {
				// only the opened content, not the row title in <summary>
				acceptNode: (n) =>
					n.parentElement?.closest('summary, mark') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT,
			});
			const nodes: Text[] = [];
			while (walker.nextNode()) nodes.push(walker.currentNode as Text);
			for (const node of nodes) {
				const text = node.data;
				re.lastIndex = 0;
				if (!re.test(text)) continue;
				re.lastIndex = 0;
				const frag = document.createDocumentFragment();
				let last = 0;
				for (const m of text.matchAll(re)) {
					const i = m.index ?? 0;
					if (i > last) frag.append(text.slice(last, i));
					const mark = document.createElement('mark');
					mark.setAttribute('data-evidence-hit', '');
					mark.textContent = m[0];
					frag.append(mark);
					last = i + m[0].length;
				}
				if (last < text.length) frag.append(text.slice(last));
				node.replaceWith(frag);
			}
		};
		// Closing an entry clears its marks
		document.querySelectorAll<HTMLDetailsElement>('details.entry').forEach((d) =>
			d.addEventListener('toggle', () => !d.open && clearMarks(d)),
		);

		// ── Jump: open the proof entries, scroll to the first, flash them ────────
		const jump = (ids: string[], phrases: string[] = []) => {
			const els = ids.map(entry).filter(Boolean) as HTMLDetailsElement[];
			if (!els.length) return;
			clearMarks();
			els.forEach((d) => {
				d.open = true;
				markIn(d, phrases);
			});
			els[0].scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' });
			els.forEach((d) => {
				d.removeAttribute('data-flash');
				void d.offsetWidth; // restart the animation
				d.setAttribute('data-flash', '');
				setTimeout(() => d.removeAttribute('data-flash'), 2200);
			});
			history.replaceState(null, '', `#entry-${ids[0]}`);
		};

		const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
		linked.forEach((b) => {
			b.addEventListener('pointerenter', () => canHover.matches && preview(b));
			b.addEventListener('focus', () => preview(b));
			b.addEventListener('click', () => jump(proofOf(b), evidenceOf(b)));
		});
		section.addEventListener('pointerleave', () => canHover.matches && clearPreview());
		section.addEventListener('focusout', (e) => {
			if (!section.contains(e.relatedTarget as Node)) clearPreview();
		});

		// ── One gust through the words when the section comes into view ──────────
		const BASE = 380;
		const runGust = () => {
			if (reduce.matches) return;
			section.setAttribute('data-gusting', '');
			const n = words.length,
				t0 = performance.now(),
				dur = 1500,
				width = 1.8,
				amp = 300;
			const step = (now: number) => {
				const front = -3 + ((now - t0) / dur) * (n + 6);
				words.forEach((w, i) => {
					const d = (i - front) / width;
					w.style.setProperty('--w', (BASE + amp * Math.exp(-d * d)).toFixed(0));
				});
				if (now - t0 < dur) requestAnimationFrame(step);
				else {
					words.forEach((w) => w.style.removeProperty('--w'));
					section.removeAttribute('data-gusting');
				}
			};
			requestAnimationFrame(step);
		};
		const io = new IntersectionObserver(
			([e]) => {
				if (e.isIntersecting) {
					runGust();
					io.disconnect(); // once per visit
				}
			},
			{ threshold: 0.45 },
		);
		io.observe(section);
	}
</script>
